<%# app/views/dashboards/index.html.erb %>

<div class="min-h-screen bg-zinc-950 text-zinc-100 font-mono">

  <%# Top Navigation %>
  <nav class="border-b border-zinc-800 bg-zinc-900/60 backdrop-blur-sm sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

      <%# Logo / Brand %>
      <div class="flex items-center gap-3">
        <div class="w-4 h-4 rounded-lg bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center shadow-lg shadow-indigo-500/20">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <span class="text-sm font-semibold tracking-widest uppercase text-zinc-300">Dashboard</span>
      </div>

      <%# Nav actions %>
      <div class="flex items-center gap-4">
        <% if user_signed_in? %>
          <div class="flex items-center gap-3">
            <div class="w-7 h-7 rounded-full bg-gradient-to-br from-indigo-400 to-violet-500 flex items-center justify-center text-xs font-bold text-white">
              <%= current_user.email[0].upcase %>
            </div>
            <span class="text-xs text-zinc-400 hidden sm:block"><%= current_user.email %></span>
            <%= link_to "Sign out",
                  destroy_user_session_path,
                  data: { turbo_method: :delete },
                  class: "text-xs px-3 py-1.5 rounded-md border border-zinc-700 text-zinc-400 hover:border-zinc-500 hover:text-zinc-200 transition-all duration-200" %>
          </div>
        <% end %>
      </div>

    </div>
  </nav>

  <%# Main Content %>
  <main class="max-w-7xl mx-auto px-6 py-12">

    <%# Page Header %>
    <div class="mb-10">
      <p class="text-xs tracking-widest uppercase text-indigo-400 mb-2">Overview</p>
      <h1 class="text-3xl font-bold text-zinc-100 tracking-tight">Welcome back<% if user_signed_in? %>, <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-violet-400"><%= current_user.email.split("@").first.capitalize %></span><% end %></h1>
      <p class="text-sm text-zinc-500 mt-1">Here's what's happening today.</p>
    </div>

    <%# Stats Grid %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
      <% [
        { label: "Total Users",    value: "2,847",  delta: "+12%",  icon: "👤", color: "indigo" },
        { label: "Revenue",        value: "$48.2k", delta: "+8.1%", icon: "💰", color: "emerald" },
        { label: "Active Sessions",value: "391",    delta: "+3.4%", icon: "⚡", color: "amber" },
        { label: "Uptime",         value: "99.98%", delta: "stable",icon: "🛡️", color: "violet" }
      ].each do |stat| %>
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-5 hover:border-zinc-700 transition-colors duration-200">
          <div class="flex items-start justify-between mb-4">
            <span class="text-xl"><%= stat[:icon] %></span>
            <span class="text-xs text-emerald-400 bg-emerald-400/10 px-2 py-0.5 rounded-full"><%= stat[:delta] %></span>
          </div>
          <p class="text-2xl font-bold text-zinc-100 mb-1"><%= stat[:value] %></p>
          <p class="text-xs text-zinc-500 uppercase tracking-wider"><%= stat[:label] %></p>
        </div>
      <% end %>
    </div>

    <%# Content Panels %>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">

      <%# Activity Feed %>
      <div class="lg:col-span-2 bg-zinc-900 border border-zinc-800 rounded-xl p-6">
        <h2 class="text-sm font-semibold text-zinc-300 uppercase tracking-widest mb-5">Recent Activity</h2>
        <div class="space-y-4">
          <% [
            { msg: "New user registered",     time: "2m ago",  dot: "bg-indigo-400" },
            { msg: "Deployment succeeded",    time: "14m ago", dot: "bg-emerald-400" },
            { msg: "Scheduled report sent",   time: "1h ago",  dot: "bg-amber-400" },
            { msg: "Database backup complete",time: "3h ago",  dot: "bg-violet-400" },
          ].each do |item| %>
            <div class="flex items-center gap-4 py-3 border-b border-zinc-800/60 last:border-0">
              <div class="w-2 h-2 rounded-full <%= item[:dot] %> shrink-0 shadow-lg"></div>
              <p class="text-sm text-zinc-300 flex-1"><%= item[:msg] %></p>
              <span class="text-xs text-zinc-600"><%= item[:time] %></span>
            </div>
          <% end %>
        </div>
      </div>

      <%# Quick Actions %>
      <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6">
        <h2 class="text-sm font-semibold text-zinc-300 uppercase tracking-widest mb-5">Quick Actions</h2>
        <div class="space-y-2">
          <% [
            { label: "New Report",   icon: "📊" },
            { label: "Invite User",  icon: "✉️" },
            { label: "View Logs",    icon: "🗂️" },
            { label: "Settings",     icon: "⚙️" },
          ].each do |action| %>
            <button class="w-full flex items-center gap-3 px-4 py-3 rounded-lg text-sm text-zinc-400 hover:bg-zinc-800 hover:text-zinc-200 transition-all duration-150 text-left border border-transparent hover:border-zinc-700">
              <span><%= action[:icon] %></span>
              <%= action[:label] %>
            </button>
          <% end %>
        </div>
      </div>

    </div>
  </main>
</div>