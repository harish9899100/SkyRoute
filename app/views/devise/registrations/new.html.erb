<style>
  * { box-sizing: border-box; }
  body { font-family: 'Outfit', sans-serif; }

  .sky-bg {
    background: linear-gradient(135deg, #0a0f1e 0%, #0d1b3e 30%, #0f2460 60%, #162d6e 100%);
  }

  .stars { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .star {
    position: absolute; background: white; border-radius: 50%;
    animation: twinkle var(--dur, 3s) ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }
  @keyframes twinkle {
    0%, 100% { opacity: 0.2; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.4); }
  }

  @keyframes flyPlane {
    0%   { transform: translateX(-120px) translateY(20px) rotate(-5deg); opacity: 0; }
    10%  { opacity: 1; }
    90%  { opacity: 1; }
    100% { transform: translateX(110vw) translateY(-60px) rotate(-5deg); opacity: 0; }
  }
  .plane-anim { animation: flyPlane 10s ease-in-out infinite; }

  @keyframes cardIn {
    0%   { opacity: 0; transform: translateY(32px) scale(0.97); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }
  .card-in { animation: cardIn 0.7s cubic-bezier(0.22,1,0.36,1) forwards; }

  @keyframes driftCloud {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-60px); }
  }

  .sky-input {
    background: rgba(255,255,255,0.05);
    border: 1.5px solid rgba(255,255,255,0.12);
    color: #e2eaff;
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
  }
  .sky-input::placeholder { color: rgba(160,180,230,0.45); }
  .sky-input:focus {
    outline: none;
    border-color: #5b8cff;
    background: rgba(91,140,255,0.08);
    box-shadow: 0 0 0 3px rgba(91,140,255,0.18);
  }
  .sky-input.input-error {
    border-color: #f87171;
    background: rgba(248,113,113,0.06);
  }

  .submit-btn {
    background: linear-gradient(135deg, #3b7df8 0%, #5b48f5 100%);
    transition: filter 0.2s, transform 0.15s, box-shadow 0.2s;
    box-shadow: 0 4px 20px rgba(91,72,245,0.35);
    border: none;
  }
  .submit-btn:hover {
    filter: brightness(1.12);
    transform: translateY(-1px);
    box-shadow: 0 6px 28px rgba(91,72,245,0.5);
  }
  .submit-btn:active { transform: translateY(0); }

  .divider-line {
    flex: 1; height: 1px;
    background: linear-gradient(to right, transparent, rgba(255,255,255,0.15), transparent);
  }

  a.sky-link { color: #7aabff; text-decoration: none; transition: color 0.15s; }
  a.sky-link:hover { color: #adc8ff; text-decoration: underline; }

  .mono { font-family: 'Space Mono', monospace; }

  .strength-bar { height: 3px; border-radius: 2px; transition: background 0.4s; }

  .google-btn {
    background: rgba(255,255,255,0.06);
    border: 1.5px solid rgba(255,255,255,0.14);
    transition: background 0.2s, border-color 0.2s, transform 0.15s;
    cursor: pointer;
  }
  .google-btn:hover {
    background: rgba(255,255,255,0.12);
    border-color: rgba(255,255,255,0.28);
    transform: translateY(-1px);
  }
  .google-btn-form { margin: 0; width: 100%; }
</style>

<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet"/>

<div class="min-h-screen sky-bg flex items-center justify-center p-4 relative overflow-hidden">

  <!-- Stars -->
  <div class="stars" id="starsLayer"></div>

  <!-- Cloud -->
  <svg class="absolute top-10 left-0 w-full opacity-10 pointer-events-none" height="120" viewBox="0 0 1200 120" preserveAspectRatio="none">
    <path d="M0,60 Q150,20 300,60 Q450,100 600,60 Q750,20 900,60 Q1050,100 1200,60 L1200,0 L0,0 Z"
          fill="white" style="animation: driftCloud 12s ease-in-out infinite alternate;"/>
  </svg>

  <!-- Flying plane -->
  <div class="absolute top-1/3 left-0 w-full pointer-events-none" style="height:48px;">
    <svg class="plane-anim" width="72" height="32" viewBox="0 0 72 32" fill="none">
      <path d="M8 16 Q24 10 60 15 Q68 15.5 70 16 Q68 16.5 60 17 Q24 22 8 16Z" fill="rgba(255,255,255,0.85)"/>
      <path d="M28 15 L36 4 L44 15Z" fill="rgba(180,210,255,0.7)"/>
      <path d="M8 15 L4 10 L10 14Z" fill="rgba(180,210,255,0.7)"/>
      <circle cx="62" cy="16" r="2.5" fill="rgba(120,180,255,0.6)"/>
    </svg>
  </div>

  <!-- Main layout -->
  <div class="relative z-10 w-full max-w-5xl mx-auto flex flex-col lg:flex-row items-center gap-10 lg:gap-16">

    <!-- LEFT: Brand -->
    <div class="flex-1 flex flex-col items-center lg:items-start text-center lg:text-left px-4">

      <!-- Logo -->
      <div class="flex items-center gap-3 mb-8">
        <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
          <circle cx="22" cy="22" r="22" fill="url(#logoGrad)"/>
          <path d="M10 22 Q16 14 26 21 Q34 27 36 22" stroke="white" stroke-width="2" stroke-linecap="round" fill="none"/>
          <path d="M20 16 L26 11 L28 17Z" fill="white" opacity="0.9"/>
          <path d="M8 22 L6 19 L12 21Z" fill="white" opacity="0.6"/>
          <defs>
            <linearGradient id="logoGrad" x1="0" y1="0" x2="44" y2="44">
              <stop offset="0%" stop-color="#3b7df8"/>
              <stop offset="100%" stop-color="#5b48f5"/>
            </linearGradient>
          </defs>
        </svg>
        <span class="text-white text-2xl font-bold tracking-tight">Sky<span style="color:#7aabff">Route</span></span>
      </div>

      <!-- Boarding pass illustration -->
      <div class="w-64 h-64 lg:w-80 lg:h-72 relative mb-8 select-none">
        <svg viewBox="0 0 320 280" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full drop-shadow-2xl">
          <defs>
            <linearGradient id="cardGrad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#1a3a8f"/>
              <stop offset="100%" stop-color="#0d1f5c"/>
            </linearGradient>
            <linearGradient id="cardGrad2" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#162d6e"/>
              <stop offset="100%" stop-color="#0a1840"/>
            </linearGradient>
            <filter id="cardShadow">
              <feDropShadow dx="0" dy="8" stdDeviation="16" flood-color="#000" flood-opacity="0.5"/>
            </filter>
            <filter id="glow2">
              <feGaussianBlur stdDeviation="2.5" result="blur"/>
              <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
          </defs>

          <!-- Back card -->
          <g transform="rotate(-8 160 140)" filter="url(#cardShadow)">
            <rect x="40" y="60" width="240" height="130" rx="16" fill="url(#cardGrad2)" stroke="rgba(91,140,255,0.2)" stroke-width="1"/>
            <line x1="40" y1="125" x2="280" y2="125" stroke="rgba(91,140,255,0.15)" stroke-dasharray="6 4"/>
            <circle cx="40" cy="125" r="10" fill="#0a0f1e"/>
            <circle cx="280" cy="125" r="10" fill="#0a0f1e"/>
          </g>

          <!-- Front boarding pass -->
          <g filter="url(#cardShadow)">
            <rect x="30" y="75" width="260" height="145" rx="16" fill="url(#cardGrad)" stroke="rgba(91,140,255,0.3)" stroke-width="1.5"/>
            <rect x="30" y="75" width="260" height="38" rx="16" fill="rgba(59,125,248,0.15)"/>
            <rect x="30" y="95" width="260" height="18" fill="rgba(59,125,248,0.15)"/>

            <!-- Logo + airline name -->
            <circle cx="56" cy="94" r="12" fill="rgba(91,140,255,0.25)"/>
            <path d="M50 94 Q53 90 58 93 Q62 96 64 94" stroke="white" stroke-width="1.2" stroke-linecap="round" fill="none"/>
            <path d="M56 91 L58 88 L60 91Z" fill="white" opacity="0.8"/>
            <text x="74" y="98" font-family="Space Mono, monospace" font-size="10" fill="rgba(162,196,255,0.9)" font-weight="700">SKYROUTE</text>
            <text x="200" y="97" font-family="Space Mono, monospace" font-size="8" fill="rgba(122,171,255,0.6)">BOARDING PASS</text>

            <!-- Perforated divider -->
            <line x1="30" y1="145" x2="290" y2="145" stroke="rgba(91,140,255,0.2)" stroke-dasharray="5 4"/>
            <circle cx="30" cy="145" r="9" fill="#0a0f1e"/>
            <circle cx="290" cy="145" r="9" fill="#0a0f1e"/>

            <!-- From -->
            <text x="50" y="130" font-family="Space Mono, monospace" font-size="18" fill="white" font-weight="700">JFK</text>
            <text x="50" y="142" font-family="Outfit, sans-serif" font-size="8" fill="rgba(162,196,255,0.5)">NEW YORK</text>

            <!-- Plane icon -->
            <g transform="translate(148, 128) rotate(90)">
              <path d="M0,-8 Q3,-3 8,0 Q3,3 0,8 Q-1,3 0,0 Q-1,-3 0,-8Z" fill="rgba(122,171,255,0.7)"/>
              <path d="M-6,0 L-2,-3 L0,0 L-2,3Z" fill="rgba(122,171,255,0.5)"/>
            </g>
            <line x1="88" y1="133" x2="138" y2="133" stroke="rgba(122,171,255,0.3)" stroke-dasharray="4 3"/>
            <line x1="162" y1="133" x2="218" y2="133" stroke="rgba(122,171,255,0.3)" stroke-dasharray="4 3"/>

            <!-- To -->
            <text x="200" y="130" font-family="Space Mono, monospace" font-size="18" fill="white" font-weight="700" text-anchor="end">DXB</text>
            <text x="200" y="142" font-family="Outfit, sans-serif" font-size="8" fill="rgba(162,196,255,0.5)" text-anchor="end">DUBAI</text>

            <!-- Info row -->
            <text x="50"  y="168" font-family="Outfit, sans-serif" font-size="7.5" fill="rgba(162,196,255,0.5)">PASSENGER</text>
            <text x="50"  y="180" font-family="Space Mono, monospace" font-size="9" fill="rgba(220,235,255,0.85)">YOUR NAME</text>
            <text x="150" y="168" font-family="Outfit, sans-serif" font-size="7.5" fill="rgba(162,196,255,0.5)">FLIGHT</text>
            <text x="150" y="180" font-family="Space Mono, monospace" font-size="9" fill="rgba(220,235,255,0.85)">SR 4291</text>
            <text x="220" y="168" font-family="Outfit, sans-serif" font-size="7.5" fill="rgba(162,196,255,0.5)">SEAT</text>
            <text x="220" y="180" font-family="Space Mono, monospace" font-size="9" fill="rgba(220,235,255,0.85)">12A</text>

            <!-- Barcode -->
            <g opacity="0.35">
              <rect x="50" y="192" width="2" height="18" fill="#7aabff"/>
              <rect x="54" y="192" width="1" height="18" fill="#7aabff"/>
              <rect x="57" y="192" width="3" height="18" fill="#7aabff"/>
              <rect x="62" y="192" width="1" height="18" fill="#7aabff"/>
              <rect x="65" y="192" width="2" height="18" fill="#7aabff"/>
              <rect x="69" y="192" width="4" height="18" fill="#7aabff"/>
              <rect x="75" y="192" width="1" height="18" fill="#7aabff"/>
              <rect x="78" y="192" width="2" height="18" fill="#7aabff"/>
              <rect x="82" y="192" width="3" height="18" fill="#7aabff"/>
              <rect x="87" y="192" width="1" height="18" fill="#7aabff"/>
              <rect x="90" y="192" width="2" height="18" fill="#7aabff"/>
            </g>

            <!-- QR box -->
            <rect x="240" y="188" width="32" height="32" rx="3" fill="none" stroke="rgba(122,171,255,0.3)" stroke-width="1"/>
            <rect x="243" y="191" width="10" height="10" rx="1" fill="rgba(122,171,255,0.25)"/>
            <rect x="259" y="191" width="10" height="10" rx="1" fill="rgba(122,171,255,0.25)"/>
            <rect x="243" y="207" width="10" height="10" rx="1" fill="rgba(122,171,255,0.25)"/>
            <rect x="255" y="203" width="5"  height="5"  rx="1" fill="rgba(122,171,255,0.2)"/>
          </g>
        </svg>
      </div>

      <h1 class="text-white text-3xl lg:text-4xl font-bold leading-tight mb-3">
        Join the Journey.<br/>
        <span class="text-transparent bg-clip-text"
              style="background-image: linear-gradient(90deg, #7aabff, #a78bfa);">
          Fly Anywhere.
        </span>
      </h1>
      <p class="text-base font-light max-w-sm" style="color: rgba(162,196,255,0.7);">
        Create your free account and unlock access to 850+ airlines, exclusive deals, and real-time flight tracking.
      </p>

      <div class="flex flex-col gap-3 mt-6">
        <div class="flex items-center gap-3">
          <span>✈️</span>
          <span class="text-sm" style="color:rgba(162,196,255,0.75);">Instant booking confirmations</span>
        </div>
        <div class="flex items-center gap-3">
          <span>🌍</span>
          <span class="text-sm" style="color:rgba(162,196,255,0.75);">190+ countries covered</span>
        </div>
        <div class="flex items-center gap-3">
          <span>🔔</span>
          <span class="text-sm" style="color:rgba(162,196,255,0.75);">Live flight alerts & updates</span>
        </div>
      </div>
    </div>

    <!-- RIGHT: Sign-up card -->
    <div class="w-full max-w-md card-in">
      <div class="rounded-2xl p-8 lg:p-10"
           style="background: rgba(255,255,255,0.04); border: 1.5px solid rgba(255,255,255,0.1);
                  backdrop-filter: blur(24px);
                  box-shadow: 0 32px 80px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.1);">

        <!-- Header -->
        <div class="mb-7">
          <div class="flex items-center gap-2 mb-1">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path d="M3 9 Q6 5 9 8 Q12 11 15 9" stroke="#7aabff" stroke-width="1.8" stroke-linecap="round" fill="none"/>
              <path d="M8 6 L10 4 L11 6.5Z" fill="#7aabff"/>
            </svg>
            <span class="text-xs mono" style="color:#7aabff; letter-spacing:0.1em;">SKYROUTE</span>
          </div>
          <h2 class="text-white text-2xl font-bold mt-1">Create your account</h2>
          <p class="text-sm mt-1" style="color:rgba(162,196,255,0.65);">Start booking flights in minutes</p>
        </div>

        <!-- Google OAuth button -->
        <%= button_to user_google_oauth2_omniauth_authorize_path, method: :post,
              form_class: "google-btn-form mb-6" do %>
          <div class="google-btn flex items-center justify-center gap-3 w-full rounded-xl py-3 px-4">
            <svg width="20" height="20" viewBox="0 0 20 20">
              <path d="M19.6 10.23c0-.68-.06-1.36-.18-2H10v3.8h5.4a4.6 4.6 0 01-2 3.02v2.5h3.22c1.89-1.74 2.98-4.3 2.98-7.32z" fill="#4285F4"/>
              <path d="M10 20c2.7 0 4.97-.9 6.62-2.44l-3.22-2.5c-.9.6-2.04.96-3.4.96-2.6 0-4.82-1.76-5.6-4.12H1.1v2.58A10 10 0 0010 20z" fill="#34A853"/>
              <path d="M4.4 11.9A5.98 5.98 0 014.1 10c0-.66.12-1.3.3-1.9V5.52H1.1A10 10 0 000 10c0 1.6.38 3.12 1.1 4.48l3.3-2.58z" fill="#FBBC05"/>
              <path d="M10 3.98c1.46 0 2.78.5 3.8 1.5l2.86-2.86A10 10 0 001.1 5.52L4.4 8.1C5.18 5.74 7.4 3.98 10 3.98z" fill="#EA4335"/>
            </svg>
            <span class="text-sm font-medium" style="color:rgba(220,235,255,0.92)">Sign up with Google</span>
          </div>
        <% end %>

        <!-- Divider -->
        <div class="flex items-center gap-3 mb-6">
          <div class="divider-line"></div>
          <span class="text-xs" style="color:rgba(162,196,255,0.45)">or sign up with email</span>
          <div class="divider-line"></div>
        </div>

        <!-- Devise form -->
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>

          <%= render "devise/shared/error_messages", resource: resource %>

          <!-- Email -->
          <div class="mb-4">
            <label class="block text-xs font-medium mb-1.5" style="color:rgba(162,196,255,0.75);">
              Email address
            </label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <rect x="1" y="3" width="14" height="10" rx="2" stroke="rgba(122,171,255,0.5)" stroke-width="1.4"/>
                  <path d="M1.5 4.5 L8 9.5 L14.5 4.5" stroke="rgba(122,171,255,0.5)" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
              </span>
              <%= f.email_field :email,
                    autofocus: true,
                    autocomplete: "email",
                    placeholder: "you@example.com",
                    class: "sky-input w-full rounded-xl pl-9 pr-4 py-2.5 text-sm" %>
            </div>
          </div>

          <!-- Password -->
          <div class="mb-4">
            <div class="flex justify-between items-center mb-1.5">
              <label class="text-xs font-medium" style="color:rgba(162,196,255,0.75);">Password</label>
              <% if @minimum_password_length %>
                <span class="text-xs" style="color:rgba(122,171,255,0.55);">
                  min <%= @minimum_password_length %> characters
                </span>
              <% end %>
            </div>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <rect x="3" y="7" width="10" height="8" rx="1.5" stroke="rgba(122,171,255,0.5)" stroke-width="1.4"/>
                  <path d="M5.5 7V5a2.5 2.5 0 015 0v2" stroke="rgba(122,171,255,0.5)" stroke-width="1.4" stroke-linecap="round"/>
                  <circle cx="8" cy="11" r="1.2" fill="rgba(122,171,255,0.6)"/>
                </svg>
              </span>
              <%= f.password_field :password,
                    autocomplete: "new-password",
                    placeholder: "Create a strong password",
                    id: "password_field",
                    oninput: "checkStrength(this.value)",
                    class: "sky-input w-full rounded-xl pl-9 pr-10 py-2.5 text-sm" %>
              <button type="button" onclick="togglePwd('password_field')"
                      class="absolute right-3 top-1/2 -translate-y-1/2 opacity-50 hover:opacity-80 transition-opacity"
                      tabindex="-1">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M1 8s2.5-5 7-5 7 5 7 5-2.5 5-7 5-7-5-7-5z" stroke="rgba(162,196,255,0.9)" stroke-width="1.4"/>
                  <circle cx="8" cy="8" r="2" stroke="rgba(162,196,255,0.9)" stroke-width="1.4"/>
                </svg>
              </button>
            </div>
            <!-- Strength bars -->
            <div class="mt-2">
              <div class="flex gap-1 mb-1">
                <div id="bar1" class="strength-bar flex-1" style="background:rgba(255,255,255,0.08);"></div>
                <div id="bar2" class="strength-bar flex-1" style="background:rgba(255,255,255,0.08);"></div>
                <div id="bar3" class="strength-bar flex-1" style="background:rgba(255,255,255,0.08);"></div>
                <div id="bar4" class="strength-bar flex-1" style="background:rgba(255,255,255,0.08);"></div>
              </div>
              <span id="strengthLabel" class="text-xs" style="color:rgba(162,196,255,0.4);">Enter a password</span>
            </div>
          </div>

          <!-- Password confirmation -->
          <div class="mb-6">
            <label class="block text-xs font-medium mb-1.5" style="color:rgba(162,196,255,0.75);">
              Confirm password
            </label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <rect x="3" y="7" width="10" height="8" rx="1.5" stroke="rgba(122,171,255,0.5)" stroke-width="1.4"/>
                  <path d="M5.5 7V5a2.5 2.5 0 015 0v2" stroke="rgba(122,171,255,0.5)" stroke-width="1.4" stroke-linecap="round"/>
                  <path d="M6 11l1.5 1.5L10 9.5" stroke="rgba(122,171,255,0.6)" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
              </span>
              <%= f.password_field :password_confirmation,
                    autocomplete: "new-password",
                    placeholder: "Repeat your password",
                    id: "password_confirmation_field",
                    oninput: "checkMatch(this.value)",
                    class: "sky-input w-full rounded-xl pl-9 pr-10 py-2.5 text-sm" %>
              <button type="button" onclick="togglePwd('password_confirmation_field')"
                      class="absolute right-3 top-1/2 -translate-y-1/2 opacity-50 hover:opacity-80 transition-opacity"
                      tabindex="-1">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M1 8s2.5-5 7-5 7 5 7 5-2.5 5-7 5-7-5-7-5z" stroke="rgba(162,196,255,0.9)" stroke-width="1.4"/>
                  <circle cx="8" cy="8" r="2" stroke="rgba(162,196,255,0.9)" stroke-width="1.4"/>
                </svg>
              </button>
              <span id="matchIcon" class="absolute right-9 top-1/2 -translate-y-1/2 hidden">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <circle cx="7" cy="7" r="6" fill="rgba(52,211,153,0.2)" stroke="#34d399" stroke-width="1.2"/>
                  <path d="M4.5 7l2 2L9.5 5" stroke="#34d399" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
              </span>
            </div>
            <p id="matchMsg" class="text-xs mt-1.5 hidden" style="color:#f87171;">Passwords do not match</p>
          </div>

          <!-- Submit -->
          <%= f.submit "Create My Account",
                class: "submit-btn w-full rounded-xl py-3 text-white text-sm font-semibold cursor-pointer tracking-wide" %>

        <% end %>

        <p class="text-center text-sm mt-5" style="color:rgba(162,196,255,0.55);">
          Already have an account?
          <%= link_to "Sign in", new_user_session_path, class: "sky-link font-medium ml-1" %>
        </p>

        <p class="text-center text-xs mt-3" style="color:rgba(162,196,255,0.35);">
          By signing up you agree to our
          <a href="#" class="sky-link">Terms</a> and
          <a href="#" class="sky-link">Privacy Policy</a>
        </p>

        <div class="hidden"><%= render "devise/shared/links" %></div>
      </div>

      <!-- Trust strip -->
      <div class="flex items-center justify-center gap-5 mt-5 opacity-50">
        <span class="text-xs" style="color:rgba(162,196,255,0.7);">🔒 256-bit SSL</span>
        <div class="w-px h-3" style="background:rgba(255,255,255,0.15)"></div>
        <span class="text-xs" style="color:rgba(162,196,255,0.7);">✅ Free forever</span>
        <div class="w-px h-3" style="background:rgba(255,255,255,0.15)"></div>
        <span class="text-xs" style="color:rgba(162,196,255,0.7);">💳 No credit card</span>
      </div>
    </div>
  </div>
</div>

<script>
  // Stars
  const layer = document.getElementById('starsLayer');
  for (let i = 0; i < 90; i++) {
    const s = document.createElement('div');
    const size = Math.random() * 2.5 + 0.5;
    s.className = 'star';
    s.style.cssText = `left:${Math.random()*100}%;top:${Math.random()*100}%;width:${size}px;height:${size}px;--dur:${2+Math.random()*4}s;--delay:-${Math.random()*6}s;`;
    layer.appendChild(s);
  }

  // Toggle password visibility
  function togglePwd(id) {
    const f = document.getElementById(id);
    f.type = f.type === 'password' ? 'text' : 'password';
  }

  // Password strength meter
  function checkStrength(val) {
    let score = 0;
    if (val.length >= 8)        score++;
    if (/[A-Z]/.test(val))      score++;
    if (/[0-9]/.test(val))      score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;

    const colors = ['#f87171','#fb923c','#facc15','#34d399'];
    const labels = ['Weak','Fair','Good','Strong'];

    for (let i = 1; i <= 4; i++) {
      document.getElementById('bar' + i).style.background =
        i <= score ? colors[score - 1] : 'rgba(255,255,255,0.08)';
    }

    const label = document.getElementById('strengthLabel');
    if (val.length === 0) {
      label.textContent = 'Enter a password';
      label.style.color = 'rgba(162,196,255,0.4)';
    } else {
      label.textContent = labels[score - 1] || 'Weak';
      label.style.color = colors[score - 1] || '#f87171';
    }
  }

  // Password match checker
  function checkMatch(val) {
    const pwd = document.getElementById('password_field').value;
    const matchIcon = document.getElementById('matchIcon');
    const matchMsg  = document.getElementById('matchMsg');
    const field     = document.getElementById('password_confirmation_field');

    if (val.length === 0) {
      matchIcon.classList.add('hidden');
      matchMsg.classList.add('hidden');
      field.classList.remove('input-error');
      return;
    }
    if (pwd === val) {
      matchIcon.classList.remove('hidden');
      matchMsg.classList.add('hidden');
      field.classList.remove('input-error');
    } else {
      matchIcon.classList.add('hidden');
      matchMsg.classList.remove('hidden');
      field.classList.add('input-error');
    }
  }
</script>