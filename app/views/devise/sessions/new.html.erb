<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Sign In – SkyRoute</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet"/>
  <style>
    * { box-sizing: border-box; }
    body { font-family: 'Outfit', sans-serif; }

    .sky-bg {
      background: linear-gradient(135deg, #0a0f1e 0%, #0d1b3e 30%, #0f2460 60%, #162d6e 100%);
    }

    .stars { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
    .star {
      position: absolute; background: white; border-radius: 50%;
      animation: twinkle var(--dur, 3s) ease-in-out infinite;
      animation-delay: var(--delay, 0s);
    }
    @keyframes twinkle {
      0%, 100% { opacity: 0.2; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.4); }
    }

    @keyframes flyPlane {
      0%   { transform: translateX(-120px) translateY(20px) rotate(-5deg); opacity: 0; }
      10%  { opacity: 1; }
      90%  { opacity: 1; }
      100% { transform: translateX(500px) translateY(-60px) rotate(-5deg); opacity: 0; }
    }
    .plane-anim { animation: flyPlane 8s ease-in-out infinite; }

    @keyframes driftCloud {
      0%   { transform: translateX(0); opacity: 0.12; }
      50%  { opacity: 0.18; }
      100% { transform: translateX(-60px); opacity: 0.12; }
    }

    @keyframes cardIn {
      0%   { opacity: 0; transform: translateY(32px) scale(0.97); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }
    .card-in { animation: cardIn 0.7s cubic-bezier(0.22,1,0.36,1) forwards; }

    .sky-input {
      background: rgba(255,255,255,0.05);
      border: 1.5px solid rgba(255,255,255,0.12);
      color: #e2eaff;
      transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    }
    .sky-input::placeholder { color: rgba(160,180,230,0.45); }
    .sky-input:focus {
      outline: none;
      border-color: #5b8cff;
      background: rgba(91,140,255,0.08);
      box-shadow: 0 0 0 3px rgba(91,140,255,0.18);
    }

    .google-btn {
      background: rgba(255,255,255,0.06);
      border: 1.5px solid rgba(255,255,255,0.14);
      transition: background 0.2s, border-color 0.2s, transform 0.15s;
    }
    .google-btn:hover {
      background: rgba(255,255,255,0.12);
      border-color: rgba(255,255,255,0.28);
      transform: translateY(-1px);
    }

    .submit-btn {
      background: linear-gradient(135deg, #3b7df8 0%, #5b48f5 100%);
      transition: filter 0.2s, transform 0.15s, box-shadow 0.2s;
      box-shadow: 0 4px 20px rgba(91,72,245,0.35);
    }
    .submit-btn:hover {
      filter: brightness(1.12);
      transform: translateY(-1px);
      box-shadow: 0 6px 28px rgba(91,72,245,0.5);
    }
    .submit-btn:active { transform: translateY(0); }

    .divider-line {
      flex: 1; height: 1px;
      background: linear-gradient(to right, transparent, rgba(255,255,255,0.15), transparent);
    }

    .check-custom:checked { accent-color: #5b8cff; }

    .alt-line { stroke-dasharray: 6 4; animation: dashMove 3s linear infinite; }
    @keyframes dashMove { to { stroke-dashoffset: -40; } }

    a.sky-link { color: #7aabff; text-decoration: none; transition: color 0.15s; }
    a.sky-link:hover { color: #adc8ff; text-decoration: underline; }

    .mono { font-family: 'Space Mono', monospace; }
  </style>
</head>
<body class="min-h-screen sky-bg flex items-center justify-center p-4 relative overflow-hidden">

  <div class="stars" id="starsLayer"></div>

  <svg class="absolute top-10 left-0 w-full opacity-10 pointer-events-none" height="120" viewBox="0 0 1200 120" preserveAspectRatio="none">
    <path d="M0,60 Q150,20 300,60 Q450,100 600,60 Q750,20 900,60 Q1050,100 1200,60 L1200,0 L0,0 Z" fill="white" style="animation: driftCloud 12s ease-in-out infinite alternate;"/>
  </svg>

  <div class="absolute top-1/4 left-0 w-full pointer-events-none" style="height:48px;">
    <svg class="plane-anim" width="72" height="32" viewBox="0 0 72 32" fill="none">
      <path d="M8 16 Q24 10 60 15 Q68 15.5 70 16 Q68 16.5 60 17 Q24 22 8 16Z" fill="rgba(255,255,255,0.85)"/>
      <path d="M28 15 L36 4 L44 15Z" fill="rgba(180,210,255,0.7)"/>
      <path d="M8 15 L4 10 L10 14Z" fill="rgba(180,210,255,0.7)"/>
      <path d="M38 14.5 Q48 14 56 14.8" stroke="rgba(150,200,255,0.5)" stroke-width="1.5" stroke-linecap="round"/>
      <circle cx="62" cy="16" r="2.5" fill="rgba(120,180,255,0.6)"/>
    </svg>
  </div>

  <div class="relative z-10 w-full max-w-5xl mx-auto flex flex-col lg:flex-row items-center gap-10 lg:gap-16">

    <!-- LEFT: Illustration + brand -->
    <div class="flex-1 flex flex-col items-center lg:items-start text-center lg:text-left px-4">

      <div class="flex items-center gap-3 mb-8">
        <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
          <circle cx="22" cy="22" r="22" fill="url(#logoGrad)"/>
          <path d="M10 22 Q16 14 26 21 Q34 27 36 22" stroke="white" stroke-width="2" stroke-linecap="round" fill="none"/>
          <path d="M20 16 L26 11 L28 17Z" fill="white" opacity="0.9"/>
          <path d="M8 22 L6 19 L12 21Z" fill="white" opacity="0.6"/>
          <defs>
            <linearGradient id="logoGrad" x1="0" y1="0" x2="44" y2="44">
              <stop offset="0%" stop-color="#3b7df8"/>
              <stop offset="100%" stop-color="#5b48f5"/>
            </linearGradient>
          </defs>
        </svg>
        <span class="text-white text-2xl font-bold tracking-tight">Sky<span style="color:#7aabff">Route</span></span>
      </div>

      <!-- Globe SVG -->
      <div class="w-64 h-64 lg:w-80 lg:h-80 relative mb-8 select-none">
        <svg viewBox="0 0 320 320" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full drop-shadow-2xl">
          <defs>
            <radialGradient id="globeGrad" cx="42%" cy="38%" r="60%">
              <stop offset="0%" stop-color="#1a3a8f"/>
              <stop offset="60%" stop-color="#0d1f5c"/>
              <stop offset="100%" stop-color="#06112e"/>
            </radialGradient>
            <radialGradient id="globeGlow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#3b7df8" stop-opacity="0.3"/>
              <stop offset="100%" stop-color="#3b7df8" stop-opacity="0"/>
            </radialGradient>
            <clipPath id="globeClip"><circle cx="160" cy="160" r="130"/></clipPath>
            <filter id="glow">
              <feGaussianBlur stdDeviation="3" result="blur"/>
              <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <linearGradient id="route1" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#5b8cff"/>
              <stop offset="100%" stop-color="#a78bfa"/>
            </linearGradient>
            <linearGradient id="route2" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#38bdf8"/>
              <stop offset="100%" stop-color="#5b8cff"/>
            </linearGradient>
            <linearGradient id="route3" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#5b8cff"/>
              <stop offset="100%" stop-color="#34d399"/>
            </linearGradient>
          </defs>

          <circle cx="160" cy="160" r="148" fill="url(#globeGlow)" opacity="0.5"/>
          <circle cx="160" cy="160" r="130" fill="url(#globeGrad)" stroke="rgba(91,140,255,0.25)" stroke-width="1.5"/>

          <g clip-path="url(#globeClip)" stroke="rgba(91,140,255,0.18)" stroke-width="1">
            <ellipse cx="160" cy="160" rx="130" ry="30"/>
            <ellipse cx="160" cy="160" rx="130" ry="70"/>
            <ellipse cx="160" cy="160" rx="130" ry="110"/>
            <line x1="30" y1="160" x2="290" y2="160"/>
            <line x1="160" y1="30" x2="160" y2="290"/>
          </g>

          <g clip-path="url(#globeClip)" fill="rgba(91,180,120,0.28)" stroke="rgba(91,180,120,0.4)" stroke-width="0.5">
            <path d="M80,90 Q100,70 130,80 Q150,85 145,110 Q140,130 120,140 Q95,145 80,130 Q65,115 80,90Z"/>
            <path d="M115,155 Q130,148 140,160 Q150,175 145,200 Q138,220 125,215 Q110,208 108,190 Q106,170 115,155Z"/>
            <path d="M168,80 Q185,74 200,82 Q210,90 205,105 Q198,115 185,112 Q170,108 165,95 Q163,87 168,80Z"/>
            <path d="M172,118 Q190,112 200,125 Q210,140 208,165 Q205,185 192,192 Q178,196 168,182 Q158,165 160,142 Q162,125 172,118Z"/>
            <path d="M205,75 Q230,65 260,75 Q278,82 275,105 Q270,122 250,128 Q230,132 215,120 Q200,108 205,90 Q206,80 205,75Z"/>
            <path d="M240,178 Q258,170 272,180 Q282,190 278,205 Q272,218 258,220 Q244,220 238,208 Q232,195 240,178Z"/>
          </g>

          <ellipse cx="120" cy="110" rx="45" ry="30" fill="white" opacity="0.04" transform="rotate(-20 120 110)"/>

          <path d="M110,110 Q160,55 195,88" stroke="url(#route1)" stroke-width="1.8" fill="none" stroke-linecap="round" class="alt-line" filter="url(#glow)" opacity="0.9"/>
          <path d="M195,88 Q230,72 255,90" stroke="url(#route2)" stroke-width="1.8" fill="none" stroke-linecap="round" class="alt-line" filter="url(#glow)" opacity="0.9"/>
          <path d="M120,130 Q125,148 128,160" stroke="url(#route3)" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0.75"/>
          <path d="M190,108 Q188,120 185,128" stroke="url(#route2)" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0.75"/>
          <path d="M255,115 Q260,148 260,180" stroke="url(#route1)" stroke-width="1.5" fill="none" stroke-linecap="round" opacity="0.7"/>

          <g filter="url(#glow)">
            <circle cx="110" cy="110" r="4" fill="#5b8cff" opacity="0.9"/>
            <circle cx="110" cy="110" r="8" fill="#5b8cff" opacity="0.2"/>
            <circle cx="195" cy="88"  r="4" fill="#a78bfa" opacity="0.9"/>
            <circle cx="195" cy="88"  r="8" fill="#a78bfa" opacity="0.2"/>
            <circle cx="255" cy="90"  r="4" fill="#38bdf8" opacity="0.9"/>
            <circle cx="255" cy="90"  r="8" fill="#38bdf8" opacity="0.2"/>
            <circle cx="128" cy="160" r="3.5" fill="#34d399" opacity="0.9"/>
            <circle cx="128" cy="160" r="7" fill="#34d399" opacity="0.2"/>
            <circle cx="183" cy="130" r="3.5" fill="#38bdf8" opacity="0.8"/>
            <circle cx="260" cy="180" r="3.5" fill="#f59e0b" opacity="0.9"/>
            <circle cx="260" cy="180" r="7" fill="#f59e0b" opacity="0.2"/>
          </g>

          <g transform="translate(152, 70) rotate(-35)">
            <path d="M0,0 Q5,-2 10,0 Q5,2 0,0Z" fill="white" opacity="0.95"/>
            <path d="M4,-1 L6,-4 L8,-1Z" fill="rgba(200,220,255,0.8)"/>
          </g>

          <circle cx="160" cy="160" r="130" fill="none" stroke="rgba(91,140,255,0.35)" stroke-width="2"/>
        </svg>
      </div>

      <h1 class="text-white text-3xl lg:text-4xl font-bold leading-tight mb-3">
        Your Gateway to<br/>
        <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(90deg, #7aabff, #a78bfa);">
          Global Skies
        </span>
      </h1>
      <p class="text-base lg:text-lg font-light max-w-xs lg:max-w-sm" style="color: rgba(162,196,255,0.7);">
        Book flights across 190+ countries. Real-time tracking, instant confirmations, unbeatable fares.
      </p>

      <div class="flex gap-6 mt-6">
        <div>
          <div class="mono font-bold text-xl" style="color:#7aabff">850+</div>
          <div class="text-xs" style="color:rgba(162,196,255,0.6)">Airlines</div>
        </div>
        <div class="w-px" style="background:rgba(255,255,255,0.1)"></div>
        <div>
          <div class="mono font-bold text-xl" style="color:#a78bfa">190+</div>
          <div class="text-xs" style="color:rgba(162,196,255,0.6)">Countries</div>
        </div>
        <div class="w-px" style="background:rgba(255,255,255,0.1)"></div>
        <div>
          <div class="mono font-bold text-xl" style="color:#34d399">24/7</div>
          <div class="text-xs" style="color:rgba(162,196,255,0.6)">Support</div>
        </div>
      </div>
    </div>

    <!-- RIGHT: Sign-in card -->
    <div class="w-full max-w-md card-in">
      <div class="rounded-2xl p-8 lg:p-10" style="background: rgba(255,255,255,0.04); border: 1.5px solid rgba(255,255,255,0.1); backdrop-filter: blur(24px); box-shadow: 0 32px 80px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.1);">

        <div class="mb-8">
          <div class="flex items-center gap-2 mb-1">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
              <path d="M3 9 Q6 5 9 8 Q12 11 15 9" stroke="#7aabff" stroke-width="1.8" stroke-linecap="round" fill="none"/>
              <path d="M8 6 L10 4 L11 6.5Z" fill="#7aabff"/>
            </svg>
            <span class="text-xs mono" style="color:#7aabff; letter-spacing:0.1em;">SKYROUTE</span>
          </div>
          <h2 class="text-white text-2xl font-bold mt-1">Welcome back</h2>
          <p class="text-sm mt-1" style="color:rgba(162,196,255,0.65);">Sign in to manage your flights</p>
        </div>

        <!-- Google OAuth -->
        <%= button_to user_google_oauth2_omniauth_authorize_path, method: :post, data: { turbo: false }, class: "google-btn flex items-center justify-center gap-3 w-full rounded-xl py-3 px-4 mb-6 no-underline bg-transparent border-none cursor-pointer" do %>
          <svg width="20" height="20" viewBox="0 0 20 20">
            <path d="M19.6 10.23c0-.68-.06-1.36-.18-2H10v3.8h5.4a4.6 4.6 0 01-2 3.02v2.5h3.22c1.89-1.74 2.98-4.3 2.98-7.32z" fill="#4285F4"/>
            <path d="M10 20c2.7 0 4.97-.9 6.62-2.44l-3.22-2.5c-.9.6-2.04.96-3.4.96-2.6 0-4.82-1.76-5.6-4.12H1.1v2.58A10 10 0 0010 20z" fill="#34A853"/>
            <path d="M4.4 11.9A5.98 5.98 0 014.1 10c0-.66.12-1.3.3-1.9V5.52H1.1A10 10 0 000 10c0 1.6.38 3.12 1.1 4.48l3.3-2.58z" fill="#FBBC05"/>
            <path d="M10 3.98c1.46 0 2.78.5 3.8 1.5l2.86-2.86A10 10 0 001.1 5.52L4.4 8.1C5.18 5.74 7.4 3.98 10 3.98z" fill="#EA4335"/>
          </svg>
          <span class="text-sm font-medium" style="color:rgba(220,235,255,0.92)">Continue with Google</span>
        <% end %>

        <!-- Google OAuth -->
        <%#= link_to user_google_oauth2_omniauth_authorize_path, method: :post, class: "google-btn flex items-center justify-center gap-3 w-full rounded-xl py-3 px-4 mb-6 no-underline" do %>
          <%# <svg width="20" height="20" viewBox="0 0 20 20">
            <path d="M19.6 10.23c0-.68-.06-1.36-.18-2H10v3.8h5.4a4.6 4.6 0 01-2 3.02v2.5h3.22c1.89-1.74 2.98-4.3 2.98-7.32z" fill="#4285F4"/>
            <path d="M10 20c2.7 0 4.97-.9 6.62-2.44l-3.22-2.5c-.9.6-2.04.96-3.4.96-2.6 0-4.82-1.76-5.6-4.12H1.1v2.58A10 10 0 0010 20z" fill="#34A853"/>
            <path d="M4.4 11.9A5.98 5.98 0 014.1 10c0-.66.12-1.3.3-1.9V5.52H1.1A10 10 0 000 10c0 1.6.38 3.12 1.1 4.48l3.3-2.58z" fill="#FBBC05"/>
            <path d="M10 3.98c1.46 0 2.78.5 3.8 1.5l2.86-2.86A10 10 0 001.1 5.52L4.4 8.1C5.18 5.74 7.4 3.98 10 3.98z" fill="#EA4335"/>
          </svg>
          <span class="text-sm font-medium" style="color:rgba(220,235,255,0.92)">Continue with Google</span> %>
        <%# end %>

        <div class="flex items-center gap-3 mb-6">
          <div class="divider-line"></div>
          <span class="text-xs" style="color:rgba(162,196,255,0.45)">or sign in with email</span>
          <div class="divider-line"></div>
        </div>

        <!-- Devise form -->
        <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

          <div class="mb-4">
            <label class="block text-xs font-medium mb-1.5" style="color:rgba(162,196,255,0.75);">Email address</label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <rect x="1" y="3" width="14" height="10" rx="2" stroke="rgba(122,171,255,0.5)" stroke-width="1.4"/>
                  <path d="M1.5 4.5 L8 9.5 L14.5 4.5" stroke="rgba(122,171,255,0.5)" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
              </span>
              <%= f.email_field :email, autofocus: true, autocomplete: "email",
                    placeholder: "you@example.com",
                    class: "sky-input w-full rounded-xl pl-9 pr-4 py-2.5 text-sm" %>
            </div>
          </div>

          <div class="mb-5">
            <div class="flex justify-between items-center mb-1.5">
              <label class="text-xs font-medium" style="color:rgba(162,196,255,0.75);">Password</label>
              <%= link_to "Forgot password?", new_user_password_path, class: "sky-link text-xs" %>
            </div>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <rect x="3" y="7" width="10" height="8" rx="1.5" stroke="rgba(122,171,255,0.5)" stroke-width="1.4"/>
                  <path d="M5.5 7V5a2.5 2.5 0 015 0v2" stroke="rgba(122,171,255,0.5)" stroke-width="1.4" stroke-linecap="round"/>
                  <circle cx="8" cy="11" r="1.2" fill="rgba(122,171,255,0.6)"/>
                </svg>
              </span>
              <%= f.password_field :password, autocomplete: "current-password",
                    placeholder: "••••••••",
                    class: "sky-input w-full rounded-xl pl-9 pr-10 py-2.5 text-sm",
                    id: "password_field" %>
              <button type="button" onclick="togglePwd()" class="absolute right-3 top-1/2 -translate-y-1/2 opacity-50 hover:opacity-80 transition-opacity" tabindex="-1">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M1 8s2.5-5 7-5 7 5 7 5-2.5 5-7 5-7-5-7-5z" stroke="rgba(162,196,255,0.9)" stroke-width="1.4"/>
                  <circle cx="8" cy="8" r="2" stroke="rgba(162,196,255,0.9)" stroke-width="1.4"/>
                </svg>
              </button>
            </div>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="flex items-center gap-2.5 mb-6">
              <%= f.check_box :remember_me, class: "check-custom w-4 h-4 rounded cursor-pointer", style: "accent-color:#5b8cff" %>
              <label for="user_remember_me" class="text-sm cursor-pointer select-none" style="color:rgba(162,196,255,0.7);">
                Keep me signed in for 30 days
              </label>
            </div>
          <% end %>

          <%= f.submit "Sign In to SkyRoute",
                class: "submit-btn w-full rounded-xl py-3 text-white text-sm font-semibold cursor-pointer tracking-wide" %>

        <% end %>

        <p class="text-center text-sm mt-6" style="color:rgba(162,196,255,0.55);">
          New to SkyRoute?
          <%= link_to "Create an account", new_user_registration_path, class: "sky-link font-medium ml-1" %>
        </p>

        <div class="hidden">
          <%= render "devise/shared/links" %>
        </div>

      </div>

      <!-- Trust strip -->
      <div class="flex items-center justify-center gap-5 mt-5 opacity-50">
        <div class="flex items-center gap-1.5">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d="M6 1L7.5 4.5H11L8 6.8 9 10.5 6 8.2 3 10.5 4 6.8 1 4.5H4.5Z" fill="#a78bfa"/>
          </svg>
          <span class="text-xs" style="color:rgba(162,196,255,0.7);">256-bit SSL</span>
        </div>
        <div class="w-px h-3" style="background:rgba(255,255,255,0.15)"></div>
        <div class="flex items-center gap-1.5">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
            <rect x="2" y="5" width="8" height="6" rx="1" stroke="#7aabff" stroke-width="1.2"/>
            <path d="M4 5V3.5a2 2 0 014 0V5" stroke="#7aabff" stroke-width="1.2"/>
          </svg>
          <span class="text-xs" style="color:rgba(162,196,255,0.7);">PCI Compliant</span>
        </div>
        <div class="w-px h-3" style="background:rgba(255,255,255,0.15)"></div>
        <div class="flex items-center gap-1.5">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
            <circle cx="6" cy="6" r="4.5" stroke="#34d399" stroke-width="1.2"/>
            <path d="M4 6l1.5 1.5L8 4" stroke="#34d399" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
          <span class="text-xs" style="color:rgba(162,196,255,0.7);">Trusted by 2M+</span>
        </div>
      </div>
    </div>
  </div>

  <script>
    const layer = document.getElementById('starsLayer');
    for (let i = 0; i < 90; i++) {
      const s = document.createElement('div');
      const size = Math.random() * 2.5 + 0.5;
      s.className = 'star';
      s.style.cssText = `left:${Math.random()*100}%;top:${Math.random()*100}%;width:${size}px;height:${size}px;--dur:${2+Math.random()*4}s;--delay:-${Math.random()*6}s;`;
      layer.appendChild(s);
    }
    function togglePwd() {
      const f = document.getElementById('password_field');
      f.type = f.type === 'password' ? 'text' : 'password';
    }
  </script>
</body>
</html>